{
  "permissions": {
    "allow": [
      "Bash(npm install:*)",
      "Bash(node --import tsx src/server.ts:*)",
      "Bash(node_modules.bintsx src/server.ts)",
      "Bash(./node_modules/.bin/tsx:*)",
      "Bash(npm ls:*)",
      "Bash(npm config:*)",
      "Bash(npm run dev:*)",
      "Bash(netstat:*)",
      "Bash(findstr:*)",
      "Bash(curl:*)",
      "Bash(echo:*)",
      "Bash(taskkill:*)",
      "Bash(cmd //c \"taskkill /PID 84444 /F\")",
      "Bash(cmd //c \"for /f \"\"tokens=5\"\" %a in \\(''netstat -ano ^| findstr :5002 ^| findstr LISTENING''\\) do taskkill /PID %a /F\")",
      "Bash(cmd //c \"for /f \"\"tokens=5\"\" %a in \\(''netstat -ano ^| findstr :3003 ^| findstr LISTENING''\\) do taskkill /PID %a /F\")",
      "Bash(cmd //c \"taskkill /IM node.exe /F\")",
      "Bash(timeout /t 3 /nobreak)",
      "Bash(npx tsc *)"
    ]
  }
}
